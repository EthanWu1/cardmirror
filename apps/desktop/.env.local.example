# Copy to .env.local (gitignored) and fill in YOUR relay's values.
# `npm run dist` bakes these into the build, so the packaged app talks to your
# relay with no per-user account and no settings step.
#
#   PAIRING_RELAY_URL  your relay's base URL, including the /relay path
#   PAIRING_TOKEN      the RELAY_TOKEN your relay was started with
#                      (relay/docker-compose.yml: RELAY_TOKEN=$(openssl rand -hex 24))

PAIRING_RELAY_URL=https://your-relay.example.com/relay
PAIRING_TOKEN=
